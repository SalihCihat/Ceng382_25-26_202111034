@page
@model lab5.Pages.IndexModel
@{
    ViewData["Title"] = "Class Management";
    var selected = Model.SelectedColumns ?? new List<string>();

    string ToggleUrl(string column)
    {
        var updated = new List<string>(selected);
        if (updated.Contains(column))
            updated.Remove(column);
        else
            updated.Add(column);

        var query = $"?SearchClassName={Model.SearchClassName}&PageNumber={Model.PageNumber}";
        foreach (var col in updated)
        {
            query += $"&SelectedColumns={col}";
        }
        return query;
    }
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="row">
        <!-- FORM -->
        <div class="col-md-4">
            <h4>@(Model.IsEditing ? "Edit Class" : "Add Class")</h4>
            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="NewClass.ClassName" class="form-label"></label>
                    <input asp-for="NewClass.ClassName" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="NewClass.StudentCount" class="form-label"></label>
                    <input asp-for="NewClass.StudentCount" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="NewClass.Description" class="form-label"></label>
                    <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                </div>

                @if (Model.IsEditing)
                {
                    <input type="hidden" asp-for="EditId" />
                    <button type="submit" asp-page-handler="Update" class="btn btn-warning">Update</button>
                }
                else
                {
                    <button type="submit" asp-page-handler="Add" class="btn btn-primary">Add</button>
                }
            </form>
        </div>

        <!-- TABLO -->
        <div class="col-md-8">
            <h4>Class List</h4>

            <!-- Filter -->
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="SearchClassName" value="@Model.SearchClassName" class="form-control" placeholder="Filter by class name" />
                    <button type="submit" class="btn btn-outline-secondary">Filter</button>
                </div>
            </form>

            <!-- Export -->
            <form method="post" asp-page-handler="Export">
                @foreach (var col in selected)
                {
                    <input type="hidden" name="SelectedColumns" value="@col" />
                }
                <button type="submit" class="btn btn-success mb-2">Export Selected Columns</button>
            </form>

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th class="@(selected.Contains("ClassName") ? "bg-info text-white" : "") text-center">
                            <a href="@ToggleUrl("ClassName")" class="text-decoration-none">Class Name</a>
                        </th>
                        <th class="@(selected.Contains("StudentCount") ? "bg-info text-white" : "") text-center">
                            <a href="@ToggleUrl("StudentCount")" class="text-decoration-none">Student Count</a>
                        </th>
                        <th class="@(selected.Contains("Description") ? "bg-info text-white" : "") text-center">
                            <a href="@ToggleUrl("Description")" class="text-decoration-none">Description</a>
                        </th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredClassList)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" asp-page-handler="Edit" asp-route-id="@item.Id" style="display:inline-block">
                                    <button type="submit" class="btn btn-sm btn-warning">Edit</button>
                                </form>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" style="display:inline-block">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="?SearchClassName=@Model.SearchClassName&PageNumber=@i@string.Join("", Model.SelectedColumns.Select(c => $"&SelectedColumns={c}"))">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
