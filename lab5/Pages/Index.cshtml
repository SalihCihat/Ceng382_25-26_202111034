@page
@model lab5.Pages.IndexModel
@{
    ViewData["Title"] = "Class Management";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="row">
        <!-- Form (Left) -->
        <div class="col-md-4">
            <h4>@(Model.IsEditing ? "Edit Class" : "Add Class")</h4>
            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="NewClass.ClassName" class="form-label"></label>
                    <input asp-for="NewClass.ClassName" class="form-control" />
                    <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewClass.StudentCount" class="form-label"></label>
                    <input asp-for="NewClass.StudentCount" class="form-control" />
                    <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewClass.Description" class="form-label"></label>
                    <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                </div>

                @if (Model.IsEditing)
                {
                    <input type="hidden" asp-for="EditId" />
                    <button type="submit" asp-page-handler="Update" class="btn btn-warning">Update</button>
                }
                else
                {
                    <button type="submit" asp-page-handler="Add" class="btn btn-primary">Add</button>
                }
            </form>
        </div>

        <!-- List (Right) -->
        <div class="col-md-8">
            <h4>Class List</h4>

            <!-- Filter -->
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="SearchClassName" value="@Model.SearchClassName" class="form-control" placeholder="Filter by class name" />
                    <button type="submit" class="btn btn-outline-secondary">Filter</button>
                </div>
            </form>

            <!-- Table -->
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredClassList)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" asp-page-handler="Edit" asp-route-id="@item.Id" style="display:inline-block">
                                    <button type="submit" class="btn btn-sm btn-warning">Edit</button>
                                </form>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" style="display:inline-block">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="?SearchClassName=@Model.SearchClassName&PageNumber=@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
