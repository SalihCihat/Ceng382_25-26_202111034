@page
@model lab5.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Class Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-5">
                <h4>@(Model.IsEditing ? "Edit Class" : "Add Class")</h4>
                <form method="post">
                    <input type="hidden" asp-for="EditId" />
                    <input type="hidden" asp-for="IsEditing" />
                    <div class="mb-3">
                        <label asp-for="NewClass.ClassName" class="form-label"></label>
                        <input asp-for="NewClass.ClassName" class="form-control" />
                        <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewClass.StudentCount" class="form-label"></label>
                        <input asp-for="NewClass.StudentCount" class="form-control" />
                        <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewClass.Description" class="form-label"></label>
                        <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                        <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                    </div>
                    <button type="submit" asp-page-handler="@(Model.IsEditing ? "Update" : "Add")" class="btn btn-primary">
                        @(Model.IsEditing ? "Update Class" : "Add Class")
                    </button>
                </form>
            </div>
            <div class="col-md-7">
                <h4>Class List</h4>
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Class Name</th>
                            <th>Student Count</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ClassList)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.ClassName</td>
                                <td>@item.StudentCount</td>
                                <td>@item.Description</td>
                                <td class="d-flex gap-2">
                                    <form method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm">Edit</button>
                                    </form>
                                    <form method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
