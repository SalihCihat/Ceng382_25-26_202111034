@page
@model lab6.Pages.IndexModel
@using lab6.Models
@{
    ViewData["Title"] = "Class Information";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .selected-column {
            background-color: #d1ecf1;
        }
    </style>
</head>
<body>
<div class="container mt-5">
    <div class="row">
        <div class="col-md-4">
            <h3>Add / Edit Class</h3>
            <form method="post">
                <input type="hidden" asp-for="ClassInfo.Id" />
                <div class="mb-3">
                    <label asp-for="ClassInfo.ClassName" class="form-label">Class Name</label>
                    <input asp-for="ClassInfo.ClassName" class="form-control" />
                    <span asp-validation-for="ClassInfo.ClassName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ClassInfo.StudentCount" class="form-label">Student Count</label>
                    <input asp-for="ClassInfo.StudentCount" type="number" class="form-control" />
                    <span asp-validation-for="ClassInfo.StudentCount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ClassInfo.Description" class="form-label">Description</label>
                    <textarea asp-for="ClassInfo.Description" class="form-control"></textarea>
                    <span asp-validation-for="ClassInfo.Description" class="text-danger"></span>
                </div>
                <button type="submit" asp-page-handler="Add" class="btn btn-primary">Add Class</button>
                <button type="submit" asp-page-handler="Update" class="btn btn-warning">Update</button>
            </form>
        </div>

        <div class="col-md-8">
            <h3>Class List</h3>
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="SearchKeyword" class="form-control" value="@Model.SearchKeyword" placeholder="Search by class name..." />
                    <button class="btn btn-outline-secondary" type="submit">Filter</button>
                </div>
            </form>

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DisplayTable)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Edit" class="btn btn-success btn-sm">Edit</button>
                                </form>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-page="/Index" asp-route-CurrentPage="@(Model.CurrentPage - 1)" asp-route-SearchKeyword="@Model.SearchKeyword">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-page="/Index" asp-route-CurrentPage="@i" asp-route-SearchKeyword="@Model.SearchKeyword">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-page="/Index" asp-route-CurrentPage="@(Model.CurrentPage + 1)" asp-route-SearchKeyword="@Model.SearchKeyword">Next</a>
                        </li>
                    </ul>
                </nav>
            }

            <h4 class="mt-4">Export Options</h4>
            <form method="post">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="SelectedColumns" value="ClassName" id="colClassName" />
                    <label class="form-check-label" for="colClassName">Class Name</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="SelectedColumns" value="StudentCount" id="colStudentCount" />
                    <label class="form-check-label" for="colStudentCount">Student Count</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="SelectedColumns" value="Description" id="colDescription" />
                    <label class="form-check-label" for="colDescription">Description</label>
                </div>
                <br />
                <button type="submit" asp-page-handler="ExportUnfiltered" class="btn btn-info mt-2">Export Unfiltered JSON</button>
                <button type="submit" asp-page-handler="ExportFiltered" class="btn btn-secondary mt-2">Export Filtered JSON</button>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
